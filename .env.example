# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# This product keeps data. Point it at your own database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SaaS Builder MCP connection token (used by .mcp.json in Claude Code).
# Claude Code reads it from your shell, not from this file:
#   export SAAS_BUILDER_MCP_TOKEN=sbmcp_...
SAAS_BUILDER_MCP_TOKEN=
